# ——— the oracle ———
# With NO key set, the diary uses your local Claude Code login via the
# Claude Agent SDK (great for localhost with a Max subscription).
# Set a key to talk to the Anthropic API directly instead:
#ANTHROPIC_API_KEY=sk-ant-...

# Force a backend regardless of key presence: "api" | "claude-code"
#RIDDLE_ORACLE=claude-code

# Model override (both backends default to claude-opus-5)
#RIDDLE_MODEL=claude-opus-5

# Critique/redraw rounds per drawing (0 = draft only, fastest)
#RIDDLE_SKETCH_PASSES=1

# Drawing candidates composed in parallel per sketch (1-3; 1 skips the judge)
#RIDDLE_SKETCH_CANDIDATES=3
